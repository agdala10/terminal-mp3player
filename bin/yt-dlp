#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Lanzador empaquetado de yt-dlp (usa el módulo incluido en bin/yt_dlp)."""
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "yt_dlp"))

from yt_dlp import main

if __name__ == "__main__":
    sys.argv[0] = re.sub(r"(-script\.pyw|\.exe)?$", "", sys.argv[0])
    sys.exit(main())
